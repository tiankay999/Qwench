# Where the Express API lives, as seen from the Next.js server.
#
# Only the server reads this. Browser requests go to /v1/public and /v1/console
# on this site's own origin, and next.config.ts proxies them, so the API address
# never reaches the bundle and there is no CORS preflight.
#
# READ AT BUILD TIME. rewrites() resolves the proxy destination during
# `next build` and writes it into .next/routes-manifest.json, so `next start`
# serves whatever was baked in and changing this afterwards does nothing. Rebuild
# after changing it, and in Docker pass it as a build arg (compose already does).
#
# Local: http://localhost:4000      Docker compose: http://backend:4000
QWENCH_API_URL=http://localhost:4000

# ---------- Chat channels (optional) ----------
# These are NEXT_PUBLIC_, so they are read at BUILD time and inlined into the
# bundle. Setting them only at run time has no effect — pass them as build args
# (docker-compose.yml already does).
#
# Leave either one empty and its button simply doesn't render, rather than
# pointing at a dead link.

# The WhatsApp bot's number, any format. Digits are kept, everything else dropped.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# The Telegram bot's username, with or without the leading @.
NEXT_PUBLIC_TELEGRAM_USERNAME=

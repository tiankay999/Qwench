# Copy to .env and fill in. Never commit .env.
#
# Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

MONGODB_URI=mongodb://localhost:27017/qwench
API_PORT=4000

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Required. The server will not start without these (minimum 16 characters).
# Changing HMAC_SECRET_KEY later invalidates every stored identifier hash.
PHONE_HASH_SALT=
HMAC_SECRET_KEY=
JWT_SECRET=

# Shared key the WhatsApp and Telegram bots send as X-Channel-Key
CHANNEL_API_KEY=

# Checks allowed per person per day on the bots
PUBLIC_DAILY_LIMIT=20

# Looks up the age of .gh websites at whois.nic.gh, for links people send. The registry's
# terms forbid high-volume automated use, so it's capped and cached. false switches it off.
GH_WHOIS_LOOKUP=true
GH_WHOIS_MAX_PER_HOUR=30

# Set to true only on a demo database. Allows src/scripts/seed-demo.js to run.
ALLOW_DEMO_SEED=false

# AI is optional. With no key set, checks still work without it.
# Provider is one of: gemini, groq, openai
AI_PROVIDER=gemini
AI_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_MS=25000
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# Qwench Docker Deployment Environment Configuration
# Copy this file to `.env` in the project root before running `docker compose up -d`
#
# Generate 64-char random hex secrets using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# --- Port Bindings ---
API_PORT=4000
WEB_PORT=3000
MONGO_PORT=27017

# --- Security Secrets (Required: Minimum 16 characters each) ---
# NOTE: Changing HMAC_SECRET_KEY after launch invalidates all stored identifier hashes!
PHONE_HASH_SALT=your_random_salt_for_phone_hashing_here_32bytes
HMAC_SECRET_KEY=your_secret_hmac_key_for_all_identifiers_here_32bytes
JWT_SECRET=your_jwt_signing_secret_for_console_sessions_here_32bytes

# Shared authentication key passed by WhatsApp and Telegram bots as X-Channel-Key
CHANNEL_API_KEY=your_channel_api_key_shared_with_bots_here

# --- CORS & URLs ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Rate Limits & Data Collection ---
PUBLIC_DAILY_LIMIT=20
COLLECTORS_ENABLED=false
COLLECT_EVERY_HOURS=1
GH_WHOIS_LOOKUP=true
GH_WHOIS_MAX_PER_HOUR=30
ALLOW_DEMO_SEED=false

# --- AI Analyzer (Optional: rules engine operates independently if empty) ---
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_VISION_MODEL=
AI_TIMEOUT_MS=25000
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Bot ---
ALLOW_GROUPS=false
QR_SMALL=true
BAILEYS_LOG_LEVEL=silent

